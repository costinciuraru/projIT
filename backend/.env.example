# ── LLM (Azure AI Foundry — GPT-5 mini) ───────────────
MODEL_NAME=
API_KEY=
AZURE_ENDPOINT=

# ── Server ─────────────────────────────────────────────
# Opționale — au valori implicite în cod dacă rămân goale (PORT=4000,
# FRONTEND_ORIGIN=http://localhost:5173).
PORT=
FRONTEND_ORIGIN=

# ── Hugging Face (Virtual Try-On) ─────────────────────
# HF_API_KEY e opțională cât timp Space-ul yisol/IDM-VTON rămâne public.
# HF_TRYON_ENDPOINT_URL e pentru migrarea viitoare la un Inference Endpoint dedicat.
HF_API_KEY=
HF_TRYON_ENDPOINT_URL=

# ── Supabase (server-side, privilegii complete) ───────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
